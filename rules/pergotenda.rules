val Number SOGLIA_APERTA = 5   // <=5% = telo disteso, esposto al sole
val Number SOGLIA_CHIUSA = 95  // >=95% = telo avvolto nel cassonetto

rule "Pergotenda - stato derivato con isteresi"
when
    Item FGR223_014_BlindsControl changed
then
    val pos = (FGR223_014_BlindsControl.state as PercentType).intValue
    val telegramActions = getActions("telegram","telegram:telegramBot:Telegram_Bot")

    if (pos <= SOGLIA_APERTA && vFlagTendaAperta.state != ON) {
        vFlagTendaAperta.postUpdate(ON)
        vFlagTendaChiusa.postUpdate(OFF)
        if (telegramActions !== null) {
          telegramActions.sendTelegram("Pergotenda chiusa, telo avvolto (" + pos + "%%)")
        }
    } else if (pos >= SOGLIA_CHIUSA && vFlagTendaChiusa.state != ON) {
        vFlagTendaChiusa.postUpdate(ON)
        vFlagTendaAperta.postUpdate(OFF)
        if (telegramActions !== null) {
          telegramActions.sendTelegram("Pergotenda aperta, telo esposto al sole (" + pos + "%%)")
        }
    } else if (pos > SOGLIA_APERTA && pos < SOGLIA_CHIUSA) {
        vFlagTendaAperta.postUpdate(OFF)
        vFlagTendaChiusa.postUpdate(OFF)
    }
end

rule "Pergotenda - sync iniziale slider invertito"
when
    System started
then
    if (FGR223_014_BlindsControl.state instanceof PercentType) {
        val pos = (FGR223_014_BlindsControl.state as PercentType).intValue
        FGR223_014_BlindsControl_Inv.postUpdate(100 - pos)
    }
end

rule "Pergotenda - sincronizza slider invertito (stato)"
when
    Item FGR223_014_BlindsControl changed
then
    val pos = (FGR223_014_BlindsControl.state as PercentType).intValue
    FGR223_014_BlindsControl_Inv.postUpdate(100 - pos)
end

rule "Pergotenda - comando da slider invertito"
when
    Item FGR223_014_BlindsControl_Inv received command
then
    val invPos = (receivedCommand as DecimalType).intValue
    FGR223_014_BlindsControl.sendCommand(100 - invPos)
end

