//     Item Total_Radiation changed
// then
//     val powerMaxTeoricAvailable = (Total_Radiation.state as Number).floatValue
//     //var v_powermaxavailable = v_i_ac_power_post * 1.6 * 14 //Calcolo potenza teorica disponibile
//     Power_Teoric_Available.postUpdate(powerMaxTeoricAvailable*1.6*14*0.1926/1000)  //Calcolo Irradazione diretta * 1,6 mq (singolo pannello) * 14 numero pannelli * 0,1926 ( modulo conversione efficienza 19,26%)
// end

rule "Calcolo potenza teorica disponibile"
when
    Item Total_Radiation changed
then
    val kWp = 14 * 0.320                       // 14 moduli da 320 Wp
    val tilt = Math::toRadians(5.0)            // inclinazione pannelli
    val panelAz = 180.0                        // orientamento pannelli (sud)

    val elev = (SunElevation.state as Number).doubleValue      // gradi
    val az = (SunAzimuth.state as Number).doubleValue           // gradi, 0 = nord
    val dirH = (Direct_Radiation.state as Number).doubleValue   // W/m2, piano orizzontale
    val dif = (Diffuse_Radiation.state as Number).doubleValue   // W/m2, piano orizzontale

    if (elev <= 3) {
        Power_Teoric_Available.postUpdate(0)
    } else {
        val sinEl = Math::sin(Math::toRadians(elev))
        val cosEl = Math::cos(Math::toRadians(elev))
        // coseno dell'angolo tra raggi e normale al pannello
        var cosTheta = sinEl * Math::cos(tilt) + cosEl * Math::sin(tilt) * Math::cos(Math::toRadians(az - panelAz))
        if (cosTheta < 0) cosTheta = 0
        val dni = dirH / sinEl                                  // irraggiamento diretto normale ai raggi
        val poa = dni * cosTheta + dif * (1 + Math::cos(tilt)) / 2
        Power_Teoric_Available.postUpdate(kWp * poa / 1000)     // kW
    }
end


// L'allarme di superamento del contratto è in prelievo.rules, insieme alla regolazione della wallbox

rule "Calcolo potenza assorbita dalla casa"
// M_Total_Real_Power_Value è lo scambio misurato dal contatore SolarEdge sul punto di consegna
// (wallbox compresa): positivo = immesso in rete, negativo = prelevato. Valori in kW
when
    Item I_AC_Power_Value changed or //Produzione energia in tempo reale KW
    Item M_Total_Real_Power_Value changed //Potenza immessa se positiva, prelevata se negativa KW
then
    if (!(M_Total_Real_Power_Value.state instanceof Number)) return;
    val scambio = (M_Total_Real_Power_Value.state as Number).floatValue
    var float produzione = 0
    if (I_AC_Power_Value.state instanceof Number) produzione = (I_AC_Power_Value.state as Number).floatValue

    // Valore senza segno per la sitemap (righe "Immessa in rete" / "Prelevata da rete")
    M_Total_Real_Power_Value_abs.postUpdate(Math::abs(scambio))
    // Consumo totale della casa (wallbox compresa): quello che produco più quello che prelevo meno quello che immetto
    Power_Used.postUpdate(produzione - scambio)
end
