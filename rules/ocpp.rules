// Momento in cui la carica è stata fermata con 0 A (null se non è ferma)
var java.time.ZonedDateTime fermoDa = null
// Minuti minimi di fermo prima di far ripartire la carica
val int minutiFermo = 2

// Limiti della wallbox in A: sotto i 6 l'auto non carica, 30 A ≈ 7 kW.
// Senza fotovoltaico il limite dei 4.5 kW tiene comunque la wallbox sotto i 19 A
val int ampsMin = 6
val int ampsMax = 30

rule "Uso della potenza disponibile per limitare la potenza della wallbox"
when
    Item M_Total_Real_Power_Value changed
then
    // Solo durante una transazione: alcuni charger vanno in SuspendedEVSE se il limite arriva prima
    val stato = Wallbox_Status.state.toString
    if (stato != "Charging" && stato != "SuspendedEVSE" && stato != "SuspendedEV") return;

    // Potenza scambiata con la rete in W: negativa = prelievo, positiva = immissione
    val scambioW = (M_Total_Real_Power_Value.state as QuantityType<Number>).toUnit("W").doubleValue
    // Per ora la wallbox non è misurata dal contatore SolarEdge. Quando lo sarà, togliere il
    // commento qui sotto, così il suo assorbimento viene sottratto dal consumo della casa
    var double wallboxW = 0
    // if (Wallbox_Power.state instanceof QuantityType) {
    //     wallboxW = (Wallbox_Power.state as QuantityType<Number>).toUnit("W").doubleValue
    // }

    // Consumo della casa senza la wallbox, e quanto resta entro i 4.5 kW di contratto
    val casaW = -scambioW - wallboxW
    val disponibileW = 4500.0 - casaW
    // Limite attuale (0 se non ancora noto)
    var int attuale = 0
    if (Wallbox_Limit.state instanceof QuantityType) {
        attuale = (Wallbox_Limit.state as QuantityType<Number>).intValue
    }

    // Isteresi: si scende subito per non superare il contratto, si sale solo
    // se avanzano almeno isteresiW oltre il gradino successivo
    val isteresiW = 150.0
    var int amps = Math::floor(disponibileW / 230.0).intValue
    if (amps > attuale) {
        amps = Math::floor((disponibileW - isteresiW) / 230.0).intValue
        if (amps < attuale) amps = attuale
    }
    // Sotto i 6 A l'auto non può caricare senza superare i 4.5 kW: 0 A ferma la carica
    // (SuspendedEVSE), riparte da sola quando tornano almeno 6 A più l'isteresi
    if (amps < ampsMin) amps = 0
    if (amps > ampsMax) amps = ampsMax

    // Dopo una fermata si riparte solo trascorsi minutiFermo minuti
    if (attuale == 0 && amps > 0 && fermoDa !== null && now.isBefore(fermoDa.plusMinutes(minutiFermo))) return;

    // Invia solo se il limite cambia
    if (amps == attuale) return;
    if (amps == 0) fermoDa = now else fermoDa = null
    logInfo("rules ocpp", "Casa: " + casaW.intValue + " W, disponibile: " + disponibileW.intValue + " W -> limite " + amps + " A")
    Wallbox_Limit.sendCommand(amps)
end
