      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Minuti sopra 21 °C — fascia 12–22",
          "description": "Minuti con media dei 4 locali strettamente >21 °C, calcolati minuto per minuto. Fascia 12:00 inclusa, 22:00 esclusa, Europe/Rome. Risultati parziali per giorni tagliati dal selettore o in corso. Nessun dato non equivale a zero.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS}"
                      },
                      "spec": {
                        "query": "import \"date\"\nimport \"timezone\"\nimport \"strings\"\n\noption location = timezone.location(name: \"Europe/Rome\")\n\n// Volumi (m³) dalle caselle in cima alla dashboard; accetta anche la virgola decimale\nvolume = (s) => float(v: strings.replaceAll(v: strings.trimSpace(v: s), t: \",\", u: \".\"))\nvCorridoio = volume(s: \"${vol_corridoio}\")\nvLetto = volume(s: \"${vol_letto}\")\nvStudio = volume(s: \"${vol_studio}\")\nvSoggiorno = volume(s: \"${vol_soggiorno}\")\nvTotale = vCorridoio + vLetto + vStudio + vSoggiorno\n\n// Ultimo campione per finestra, riempito col valore precedente.\n// Si leggono 3 ore prima dell'inizio intervallo perché alcuni item\n// sono persistiti solo al cambio di valore.\nsensore = (m, nome, peso, passo, fascia=false) =>\n    from(bucket: \"openhab\")\n        |> range(start: date.sub(d: 3h, from: v.timeRangeStart), stop: v.timeRangeStop)\n        |> filter(fn: (r) => r._measurement == m and r._field == \"value\")\n        |> aggregateWindow(every: passo, fn: last, createEmpty: true, timeSrc: \"_start\")\n        |> fill(usePrevious: true)\n        |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n        // Fascia 12:00 inclusa, 22:00 esclusa, ora di Roma (solo per il conteggio giornaliero)\n        |> filter(fn: (r) => not fascia or (date.hour(t: r._time) >= 12 and date.hour(t: r._time) < 22))\n        |> map(fn: (r) => ({_time: r._time, _field: nome, _value: float(v: r._value) * peso}))\n\nunion(tables: [\n    sensore(m: \"SonoOffT\", nome: \"Corridoio\", peso: vCorridoio, passo: 1m, fascia: true),\n    sensore(m: \"SCD402_Temperature\", nome: \"Letto\", peso: vLetto, passo: 1m, fascia: true),\n    sensore(m: \"SCD401_Temperature\", nome: \"Studio\", peso: vStudio, passo: 1m, fascia: true),\n    sensore(m: \"FGMS001_008_Temp\", nome: \"Soggiorno\", peso: vSoggiorno, passo: 1m, fascia: true),\n])\n    |> group()\n    |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n    |> filter(fn: (r) => exists r.Corridoio and exists r.Letto and exists r.Studio and exists r.Soggiorno)\n    |> map(fn: (r) => ({_time: r._time, media: (r.Corridoio + r.Letto + r.Studio + r.Soggiorno) / vTotale}))\n    |> map(fn: (r) => ({r with giorno: date.truncate(t: r._time, unit: 1d), sopra: if r.media > 21.0 then 1 else 0}))\n    |> group(columns: [\"giorno\"])\n    |> reduce(\n        identity: {sopra: 0, valutabili: 0, massima: -1000.0},\n        fn: (r, accumulator) => ({\n            sopra: accumulator.sopra + r.sopra,\n            valutabili: accumulator.valutabili + 1,\n            massima: if r.media > accumulator.massima then r.media else accumulator.massima,\n        }),\n    )\n    |> group()\n    |> map(fn: (r) => ({Giorno: r.giorno, \"Minuti sopra 21 °C\": r.sopra, \"Minuti valutabili\": r.valutabili, \"Massima nella fascia (°C)\": r.massima}))\n    |> sort(columns: [\"Giorno\"])\n"
                      }
