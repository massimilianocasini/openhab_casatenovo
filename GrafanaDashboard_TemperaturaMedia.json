field\"], valueColumn: \"_value\")\n    |> filter(fn: (r) => exists r.Corridoio and exists r.Letto and exists r.Studio and exists r.Soggiorno)\n    |> keep(columns: [\"_time\", \"Corridoio\", \"Letto\", \"Studio\", \"Soggiorno\"])\n"
