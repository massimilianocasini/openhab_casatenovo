String  Wallbox_Status   "Stato [MAP(ocpp_status.map):%s]" { channel="ocpp:connector:main:wallbox:c1:charge-point-status" }
Switch  Wallbox_Cable    "Cable connected [MAP(ocpp_status.map):%s]"          { channel="ocpp:connector:main:wallbox:c1:cable-connected" }
Switch  Wallbox_Charging "Charging"             (gInfluxdbChange)    { channel="ocpp:connector:main:wallbox:c1:charging" }
Number:ElectricCurrent Wallbox_Limit "Limit [%.0f A]" (gInfluxdbChange) { channel="ocpp:connector:main:wallbox:c1:charge-limit" }
Number:Power Wallbox_Limit_Power "Limit Power [%.0f W]" (gInfluxdbChange) { channel="ocpp:connector:main:wallbox:c1:power-limit" }
Number Wallbox_Charging_Phases "Charging phases [%.0f]" (gInfluxdbChange) { channel="ocpp:connector:main:wallbox:c1:number-phases" }
Switch  Wallbox_Pause    "Pause"                    { channel="ocpp:connector:main:wallbox:c1:pause" }
// Meter Value only with meter values enabled in the wallbox configuration
// Number:ElectricCurrent Wallbox_Current_import_1 "Current l1[%.0f A]" { channel="ocpp:connector:main:wallbox:c1:current-import-l1" }
// Number:ElectricCurrent Wallbox_Current_import_2 "Current l2[%.0f A]" { channel="ocpp:connector:main:wallbox:c1:current-import-l2" }
// Number:ElectricCurrent Wallbox_Current_import_3 "Current l3[%.0f A]" { channel="ocpp:connector:main:wallbox:c1:current-import-l3" }
// Number:ElectricPotential Wallbox_Voltage "Voltage [%.0f V]" (gInfluxdbChange) ["Measurement", "Voltage"] { channel="ocpp:connector:main:wallbox:c1:voltage-l1" }
Number:Power  Wallbox_Power  "Power [%.0f W]"   (gInfluxdbChange)  ["Measurement", "Power"]  { channel="ocpp:connector:main:wallbox:c1:power-active-import" }
Number:Energy Wallbox_Energy "Energy [%.2f kWh]"    (gInfluxdbChange)   ["Measurement", "Energy"]  { channel="ocpp:connector:main:wallbox:c1:energy-active-import" }
Number:Energy Session_Energy "Session energy [%.2f kWh]" (gInfluxdbChange) ["Measurement", "Energy"]  { channel="ocpp:connector:main:wallbox:c1:session-energy" }
Number:ElectricPotential Wallbox_Voltage "Voltage [%.0f V]" (gInfluxdbFast) ["Measurement", "Voltage"] { channel="ocpp:connector:main:wallbox:c1:voltage" }

Switch  Wallbox_Reset    "Reset charger"            { channel="ocpp:chargepoint:main:wallbox:reset" }
Switch  Wallbox_Force_Stop "Force stop"

// Energia caricata per periodo (calcolata da Wallbox_Energy con la persistenza InfluxDB)
Number:Energy Wallbox_Energy_Oggi "Energia caricata oggi [%.2f kWh]"        (gInfluxdbChange) ["Measurement", "Energy"]
Number:Energy Wallbox_Energy_Mese "Energia caricata questo mese [%.1f kWh]" (gInfluxdbChange) ["Measurement", "Energy"]
Number:Energy Wallbox_Energy_Anno "Energia caricata quest'anno [%.1f kWh]"  (gInfluxdbChange) ["Measurement", "Energy"]

// Contatore parziale azzerabile (come il parziale dei km): Wallbox_Energy meno l'offset salvato all'azzeramento
Number:Energy Wallbox_Energy_Parziale "Energia parziale [%.2f kWh]"           (gInfluxdbChange) ["Measurement", "Energy"]
Number:Energy Wallbox_Energy_Offset   "Energia all'azzeramento [%.2f kWh]"    (gMapDb)
DateTime      Wallbox_Energy_Azzerato "Parziale azzerato il [%1$td/%1$tm/%1$tY %1$tH:%1$tM]" (gMapDb)
Switch        Wallbox_Energy_Azzera   "Azzera energia parziale"               { autoupdate="false" }