String  Wallbox_Status   "Status [%s]"              { channel="ocpp:connector:main:wallbox:c1:charge-point-status" }
Switch  Wallbox_Cable    "Cable connected"          { channel="ocpp:connector:main:wallbox:c1:cable-connected" }
Number:Power  Wallbox_Power  "Power [%.0f W]"   (gInfluxdbChange)  ["Measurement", "Power"]  { channel="ocpp:connector:main:wallbox:c1:power-active-import" }
Number:Energy Wallbox_Energy "Energy [%.2f kWh]"    (gInfluxdbChange)   ["Measurement", "Energy"]  { channel="ocpp:connector:main:wallbox:c1:energy-active-import" }

Switch  Wallbox_Charging "Charging"             (gInfluxdbChange)    { channel="ocpp:connector:main:wallbox:c1:charging" }
Switch  Wallbox_Pause    "Pause"                    { channel="ocpp:connector:main:wallbox:c1:pause" }
Number:ElectricCurrent Wallbox_Limit "Limit [%.0f A]" (gInfluxdbChange) { channel="ocpp:connector:main:wallbox:c1:charge-limit" }
Switch  Wallbox_Reset    "Reset charger"            { channel="ocpp:chargepoint:main:wallbox:reset" }
Number:ElectricCurrent Wallbox_Current_import_1 "Current l1[%.0f A]" { channel="ocpp:connector:main:wallbox:c1:current-import-l1" }
Number:ElectricCurrent Wallbox_Current_import_2 "Current l2[%.0f A]" { channel="ocpp:connector:main:wallbox:c1:current-import-l2" }
Number:ElectricCurrent Wallbox_Current_import_3 "Current l3[%.0f A]" { channel="ocpp:connector:main:wallbox:c1:current-import-l3" }
Number:Energy Session_Energy "Session energy [%.2f kWh]" (gInfluxdbChange) ["Measurement", "Energy"]  { channel="ocpp:connector:main:wallbox:c1:session-energy" }
Number:ElectricPotential Wallbox_Voltage "Voltage [%.0f V]" (gInfluxdbChange) ["Measurement", "Voltage"] { channel="ocpp:connector:main:wallbox:c1:voltage" }
Switch  Wallbox_Force_Stop "Force stop"